---
import Icon from "../components/icon.astro";
import { SITE_DESCRIPTION } from "../consts";
import Base from "../layouts/base.astro";
---

<Base title={`Seite nicht gefunden | John Schmidt`} description={SITE_DESCRIPTION} class="pt-6">
  <section class="space-y-6 text-text-light leading-relaxed">
    <p class="text-3xl font-light text-text">404</p>
    <p>
      Diese Seite gibt es nicht — vielleicht wurde sie verschoben oder existierte
      nie.
    </p>
    <a
      class="inline-block font-sans text-sm text-text-muted/60 hover:text-accent transition-colors duration-200"
      href="/"
      >Zur Startseite <Icon name="caret-right" class="size-3" /></a
    >
  </section>
</Base>
