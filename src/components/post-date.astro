---
import { formatDate } from "../lib/date";

interface Props {
    class?: string;
    date: Date;
    updatedDate?: Date;
}

const { date, updatedDate, class: className } = Astro.props;
---

<p class:list={[className, "flex tabular-nums"]}>
    <time datetime={date.toISOString()}>{formatDate(date)}</time>
    {
        updatedDate && (
            <span class="italic">
                — Zuletzt aktualisiert am{" "}
                <time datetime={updatedDate.toISOString()}>
                    {formatDate(updatedDate)}
                </time>
            </span>
        )
    }
</p>
