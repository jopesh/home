---
import type { CollectionEntry } from "astro:content";
import { dateTransitionName, titleTransitionName } from "../lib/transitions";
import PostDate from "./post-date.astro";

interface Props {
    basePath?: string;
    posts: CollectionEntry<"blog">[];
}

const { posts, basePath = "/" } = Astro.props;
---

<div class="space-y-1">
    {
        posts.map((post) => (
            <a
                class="group flex items-baseline gap-4 py-1 no-underline"
                href={`${basePath}${post.id}/`}
            >
                <PostDate
                    class="w-28 shrink-0 font-sans tabular-nums text-sm text-text-muted"
                    date={post.data.pubDate}
                    transitionName={dateTransitionName(post.id)}
                />
                <h2
                    class="flex text-text transition-colors duration-200 group-hover:text-accent"
                    style={`view-transition-name: ${titleTransitionName(post.id)}`}
                >
                    {post.data.title}
                </h2>
            </a>
        ))
    }
</div>
