{
  "name": "catppuccin-mocha",
  "type": "dark",
  "colors": {
    "editor.background": "#181825",
    "editor.foreground": "#cdd6f4"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#6c7086", "fontStyle": "italic" }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": { "foreground": "#a6e3a1" }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "storage.type",
        "storage.modifier"
      ],
      "settings": { "foreground": "#cba6f7" }
    },
    {
      "scope": ["constant.numeric", "constant.language"],
      "settings": { "foreground": "#fab387" }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": { "foreground": "#89b4fa" }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class",
        "entity.name.class"
      ],
      "settings": { "foreground": "#f9e2af" }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter",
        "meta.definition.variable"
      ],
      "settings": { "foreground": "#cdd6f4" }
    },
    {
      "scope": ["entity.name.tag", "punctuation.definition.tag", "meta.tag"],
      "settings": { "foreground": "#89b4fa" }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.html"
      ],
      "settings": { "foreground": "#f9e2af" }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": { "foreground": "#9399b2" }
    },
    {
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.comparison",
        "keyword.operator.logical"
      ],
      "settings": { "foreground": "#89dceb" }
    },
    {
      "scope": [
        "variable.other.property",
        "support.variable.property",
        "meta.object-literal.key"
      ],
      "settings": { "foreground": "#b4befe" }
    },
    {
      "scope": ["constant.other.color", "support.constant"],
      "settings": { "foreground": "#fab387" }
    },
    {
      "scope": ["entity.other.inherited-class", "support.type.builtin"],
      "settings": { "foreground": "#f9e2af" }
    },
    {
      "scope": ["string.regexp"],
      "settings": { "foreground": "#f5c2e7" }
    },
    {
      "scope": ["meta.decorator", "punctuation.decorator"],
      "settings": { "foreground": "#89b4fa" }
    },
    {
      "scope": ["markup.heading", "entity.name.section"],
      "settings": { "foreground": "#89b4fa", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.bold"],
      "settings": { "fontStyle": "bold" }
    },
    {
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "scope": ["markup.inline.raw", "markup.fenced_code"],
      "settings": { "foreground": "#a6e3a1" }
    }
  ]
}
